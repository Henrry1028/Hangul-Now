{
  "name": "hangul-now",
  "version": "1.0.0",
  "description": "외국인을 위한 메신저 중심 한국어 교육 플랫폼 - Google Gemini API 및 Google Cloud / Firebase 생태계 기반",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "tsx server.js",
    "dev": "tsx server.js",
    "test": "node --test \"src/**/*.test.js\"",
    "test:db": "node --env-file=.env --test \"src/**/*.test.js\"",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:import-firebase": "node --env-file=.env scripts/migrate-firebase-data.mjs",
    "deploy:prod": "pwsh -File ./scripts/deploy-production.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "jose": "^6.2.12",
    "kiwi-nlp": "^0.23.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "puppeteer": "^25.12.0",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.15"
  },
  "keywords": [
    "hangul-now",
    "gemini",
    "korean-learning",
    "firebase",
    "google-cloud"
  ],
  "author": "Hangul Now Team",
  "license": "ISC",
  "engines": {
    "node": ">=20 <23"
  }
}
