# ============================================================
# [보안 주의사항]
# 1. 로컬 개발 시에는 과금 한도(Quota)가 걸린 테스트/개발 전용 키만 입력하세요.
# 2. 실제 운영(Production) 키는 절대 로컬 파일에 저장하지 마세요. (GCP Secret Manager 사용)
# 3. .env 파일은 Git 및 외부 공유 금지 대상입니다.
# ============================================================
# Google Gemini API 키 설정
# https://aistudio.google.com/app/apikey 에서 발급받을 수 있습니다.
GEMINI_API_KEY=
GEMINI_DIALOGUE_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live-extended-thinking
GEMINI_TUTOR_LIVE_MODEL=gemini-3.8-live-extended-thinking
GEMINI_REVIEW_MODEL=gemini-3.8-flash
GEMINI_REVIEW_TTS_MODEL=gemini-3.8-flash-lite-tts
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Cloudflare R2 파일 저장소 (선택)
# 네 값을 모두 채우면 복습 PDF·오디오 리뷰가 Firebase Storage 대신 R2에 저장됩니다.
# 하나라도 비어 있으면 기존 Firebase Storage로 동작합니다.
# 버킷 이름은 R2_BUCKET 대신 R2_BUCKET_NAME으로 넣어도 됩니다. 엔드포인트는 계정 ID로 자동 구성됩니다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase (선택)
# SUPABASE_DB_URL을 채우면 학습 이력·수업 기록·튜터 기억·채팅·오답 노트를 Firestore 대신 Postgres에 저장합니다.
# 비어 있으면 기존 Firestore로 동작합니다. 테이블은 `npm run db:migrate`로 만듭니다.
# 접속 문자열은 대시보드 Connect 화면의 "Session pooler" 것을 쓰고, 비밀번호는 영문·숫자로 정하는 편이 안전합니다.
SUPABASE_DB_URL=
# SUPABASE_URL을 채우면 로그인이 Firebase 대신 Supabase Auth로 바뀝니다 (서버 토큰 검증과 화면의 로그인 방식이 함께 전환).
# 사용자 ID 체계가 서로 달라 SUPABASE_DB_URL과 반드시 함께 켜고 꺼야 합니다.
# SUPABASE_PUBLISHABLE_KEY는 브라우저에 내려가는 공개 키입니다.
# SUPABASE_SECRET_KEY는 서버가 쓰지 않고 데이터 이전 스크립트(npm run db:import-firebase)와 테스트만 씁니다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 관리자 회원 목록의 Google Drive 저장이 권한 팝업에 쓰는 Google OAuth 클라이언트 ID (공개 값, 선택).
# 비워 두면 Supabase의 Google 로그인 설정에서 자동으로 읽어 옵니다.
# 어느 쪽이든 사이트 주소가 그 클라이언트의 "승인된 JavaScript 원본"에 등록돼 있어야 팝업이 열립니다.
GOOGLE_OAUTH_CLIENT_ID=

# Google Cloud TTS Neural2 인증
# Firebase 서비스 계정 JSON 또는 해당 JSON의 Base64 문자열을 사용할 수 있습니다.
GOOGLE_CLOUD_TTS_SERVICE_ACCOUNT_KEY=
# 또는 로컬 ADC 자격증명 파일 경로를 지정합니다.
GOOGLE_APPLICATION_CREDENTIALS=

# 서버 포트
PORT=3000

# 관리자 계정 목록 (쉼표 구분)
ADMIN_EMAILS=hopeproof@gmail.com
