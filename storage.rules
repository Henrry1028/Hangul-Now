rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 튜터 음원 및 캐릭터 이미지는 공개 읽기 가능
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // 학습자 음성 녹음 (본인만 업로드/읽기 가능, 30일 보관 정책)
    match /user_recordings/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
